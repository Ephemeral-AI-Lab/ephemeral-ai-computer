{
  "name": "@cloudflare/computerd",
  "version": "0.1.0-alpha.1",
  "description": "Computer daemon CLI and FUSE mount. Source-only; the distributable lives at @cloudflare/computer-computerd-linux-x64.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "bin": {
    "computerd": "./dist/cli/computerd.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:bin": "node ./scripts/build-bin.mjs",
    "build:docker": "node ./scripts/build-docker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../script/run-vitest-wsl.mjs",
    "publish:docker": "node ./scripts/build-docker.mjs --push"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cloudflare/computer-rpc": "*",
    "@cloudflare/dofs": "*",
    "@ephemeralai/fs": "file:../../ephemeral-ai-fs-m7-audit/packages/fs",
    "@ephemeralai/fs-node-vfs": "file:../../ephemeral-ai-fs-m7-audit/packages/node-vfs",
    "@ephemeralai/fs-replication": "file:../../ephemeral-ai-fs-m7-audit/packages/replication",
    "@ephemeralai/fs-sqlite-node": "file:../../ephemeral-ai-fs-m7-audit/packages/sqlite-node",
    "@platformatic/vfs": "^0.4.0",
    "fuse-native": "^2.2.6"
  },
  "devDependencies": {
    "vitest": "^4.1.7"
  }
}
